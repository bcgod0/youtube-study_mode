{
    "manifest_version": 3,
    "name": "YouTube Clean Mode",
    "description": "Hide YouTube controls on hover. Toggle windowed fullscreen with the extension button.",
    "version": "1.0.0",
    "icons": {
        "16": "icons/icon.svg",
        "48": "icons/icon.svg",
        "128": "icons/icon.svg"
    },
    "action": {
        "default_icon": "icons/icon.svg",
        "default_title": "Toggle Windowed Fullscreen"
    },
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": ["*://*.youtube.com/*"],
            "js": ["content-script.js"],
            "css": ["styles.css"],
            "run_at": "document_idle"
        }
    ],
    "permissions": ["activeTab"],
    "host_permissions": ["*://*.youtube.com/*"]
}
